# Environment variables for the Vercel project
# (Project -> Settings -> Environment Variables). Everything here is server-side
# except the VITE_* entries, which are baked into the public bundle.
#
# This file is a TEMPLATE and is committed to git: never write real values into
# it. Generate the secrets yourself and paste them straight into Vercel:
#
#   openssl rand -hex 32
#
# DATABASE_URL and REDIS_URL can be left out entirely if you add Neon and
# Upstash from the Vercel marketplace: the backend also reads POSTGRES_URL,
# POSTGRES_PRISMA_URL, KV_URL and UPSTASH_REDIS_URL.

BOT_TOKEN=<from @BotFather>
BOT_USERNAME=<bot username without @>
# May be left empty on the first deploy: the backend falls back to VERCEL_URL.
WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>
INTERNAL_API_TOKEN=<openssl rand -hex 32>
CRON_SECRET=<openssl rand -hex 32>
ADMIN_TELEGRAM_IDS=<your Telegram id, ask @userinfobot>

DATABASE_URL=
REDIS_URL=

ENVIRONMENT=production
ENABLE_SCHEDULER=0
CORS_ORIGINS=*

TON_MANIFEST_URL=
TON_RECEIVER_ADDRESS=

# Empty means "same origin", which is correct for this single-project setup.
VITE_API_URL=
VITE_TON_MANIFEST_URL=
VITE_BOT_USERNAME=
