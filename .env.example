# ---------------------------------------------------------------------------
# gg.gram — environment
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=development           # development | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma separated. Use your Mini App origin in production, not "*".
CORS_ORIGINS=*

# --- telegram --------------------------------------------------------------
# From @BotFather. Backend and bot only — never expose it to the frontend.
BOT_TOKEN=123456789:AA-your-bot-token
BOT_USERNAME=your_bot
# Public HTTPS URL of the Mini App (also used as the TON Connect domain check).
WEBAPP_URL=https://your-app.vercel.app
# Any random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string
# Seconds an initData signature stays acceptable.
INIT_DATA_TTL=86400
# Allow playing in a plain browser through a guest account (no Telegram).
# Handy for testing; leave false in production, since anyone with the URL can
# then create accounts. Guests get their own id range and are never admins.
ALLOW_BROWSER_LOGIN=false

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://gg:gg@localhost:5432/gg
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Set to 0 behind a transaction-mode pooler (Neon, Supabase, pgbouncer).
DB_STATEMENT_CACHE_SIZE=100

# --- redis -----------------------------------------------------------------
# Locks, rate limits, idempotency and websocket fan-out. Upstash: rediss://...
REDIS_URL=redis://localhost:6379/0

# --- auth & access ---------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-to-32-random-bytes
JWT_TTL=604800
# Shared secret between the bot process and the backend's /api/internal/* routes.
INTERNAL_API_TOKEN=change-me-internal
# Protects /api/internal/tick. On Vercel this must equal the CRON_SECRET env var.
CRON_SECRET=change-me-cron
# Comma separated Telegram user ids with admin access.
ADMIN_TELEGRAM_IDS=

# --- economy ---------------------------------------------------------------
SIGNUP_BONUS=100
HOUSE_EDGE=0.04
PVP_RAKE_PERCENT=5
PVP_MIN_BET=10
PVP_MAX_BET=100000
PVP_COUNTDOWN_SECONDS=20
PVP_SPIN_SECONDS=6
PVP_MAX_PLAYERS=12
SOLO_MIN_BET=10
SOLO_MAX_BET=50000
REFERRAL_SIGNUP_BONUS=50
REFERRAL_TOPUP_PERCENT=10

# --- rate limits (requests/seconds) ----------------------------------------
RATE_LIMIT_DEFAULT=120/60
RATE_LIMIT_PLAY=30/60
RATE_LIMIT_AUTH=20/60

# --- TON -------------------------------------------------------------------
TON_MANIFEST_URL=https://your-app.vercel.app/tonconnect-manifest.json
# Address that receives on-chain transfers (public address only).
TON_RECEIVER_ADDRESS=
TON_API_BASE=https://tonapi.io
TON_API_KEY=

# --- bot process (docker/VPS only) -----------------------------------------
BACKEND_URL=http://backend:8000
# Set 0 in serverless; 1 for the long-running uvicorn deployment.
ENABLE_SCHEDULER=1

# --- frontend (build time, VITE_* is public) -------------------------------
# Empty means "same origin" — correct when the API is served from the same
# Vercel project. Never put secrets in a VITE_ variable.
VITE_API_URL=
VITE_TON_MANIFEST_URL=https://your-app.vercel.app/tonconnect-manifest.json
VITE_BOT_USERNAME=your_bot
