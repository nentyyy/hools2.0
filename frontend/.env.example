# Base URL of the backend API. Leave empty to call the same origin
# (works when the API is served from the same Vercel project).
VITE_API_URL=

# Public URL of the TON Connect manifest (must be reachable over HTTPS).
VITE_TON_MANIFEST_URL=https://your-app.vercel.app/tonconnect-manifest.json

# Bot username, used for share links.
VITE_BOT_USERNAME=your_bot
